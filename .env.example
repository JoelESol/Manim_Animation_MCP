# animation-mcp configuration (docker compose reads this file automatically).
# Copy to .env and change the values for your deployment:
#   cp .env.example .env && nano .env

# --- Addressing (the important one) ---
# The address your MCP client and browser will actually use. It is used BOTH
# for download links AND as the accepted Host for the MCP endpoint. If this
# doesn't match how you reach the server, you'll get 421 Misdirected Request.
# Examples:
#   http://203.0.113.10:8000             (public IP)
#   http://192.168.1.20:8000             (private/LAN IP)
#   http://animation-server:8000         (hostname resolvable by the client)
ANIMATION_MCP_PUBLIC_URL=http://127.0.0.1:8000

# --- Concurrency & limits ---
# How many renders may run at once; each render peaks at roughly
# 215 MB (480p15) to 700 MB (1080p60) of RAM. Size to your box.
ANIMATION_MCP_MAX_CONCURRENT_RENDERS=2
# How long a render submission waits for a free slot before failing busy.
ANIMATION_MCP_QUEUE_WAIT_SECONDS=30
# Per-render subprocess timeout in seconds.
ANIMATION_MCP_TIMEOUT=120

# --- Download links ---
# Default link lifetime in hours.
ANIMATION_MCP_LINK_TTL_HOURS=24
# HMAC secret for signed links. Set a fixed random value (e.g. output of
# `openssl rand -hex 32`) so links keep working across container restarts.
ANIMATION_MCP_LINK_SECRET=
# Extra hostnames (comma-separated) the MCP endpoint will accept, beyond the
# one in ANIMATION_MCP_PUBLIC_URL. Useful if you reach the box by several
# names/IPs, e.g. 192.168.1.20,animation-server
ANIMATION_MCP_ALLOWED_HOSTS=
